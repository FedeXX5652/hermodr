<!doctype html>
<html lang="es">
<head>
{% include "_head.html.j2" %}
<title>{{ title }} · Ediciones anteriores</title>
<style>
.masthead h1 { font-size: clamp(48px, 8vw, 88px); }
ol { list-style: none; margin: 8px 0 0; padding: 0; border-top: 4px double var(--ink); }
li { border-bottom: 1px solid var(--rule); }
li a { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 4px 20px; padding: 16px 4px; text-decoration: none; transition: background-color .2s, padding .3s var(--ease); }
li a:hover { background: var(--surface); padding-left: 14px; }
li strong { font-size: 21px; font-weight: 600; }
li strong span { color: var(--accent); }
.empty { text-align: center; padding: 60px 20px; font-style: italic; color: var(--muted); }
</style>
</head>
<body>
<div class="wrap">
  <div class="topbar meta"><span>Ediciones anteriores</span><div class="right">{% include "_theme_button.html.j2" %}</div></div>
  <div class="masthead"><h1>{{ title[:-1] }}<span>{{ title[-1:] }}</span></h1><p>Todo lo que el mensajero trajo</p></div>
  {% if editions %}
  <ol>
  {% for e in editions %}
    <li class="reveal in"><a href="{{ e.id }}/index.html"><strong><span>N.º {{ e.id }}</span> · {{ e.date }}</strong>
      <span class="meta">armada a las {{ e.built }} · {{ e.n }} historias{% if e.no_model %} · sin modelo{% endif %}</span></a></li>
  {% endfor %}
  </ol>
  {% else %}<p class="empty">Todavía no hay ediciones.</p>{% endif %}
</div>
{% include "_theme_script.html.j2" %}
</body>
</html>
